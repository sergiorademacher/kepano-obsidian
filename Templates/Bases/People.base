filters:
  and:
    - '!file.name.contains("Template")'
    - categories.contains(link("People"))
formulas:
  Age: (now() - birthday).years.floor()
properties:
  file.name:
    displayName: Name
  note.tags:
    displayName: Tags
  note.birthday:
    displayName: Birthday
views:
  - type: table
    name: All people
    order:
      - file.name
      - tags
      - birthday
      - formula.Age
    sort:
      - property: file.name
        direction: ASC
      - property: tags
        direction: ASC
      - property: formula.Age
        direction: DESC
      - property: birthday
        direction: DESC
    columnSize:
      note.tags: 209
      formula.Age: 99
  - type: table
    name: Birthdays this month
    filters:
      and:
        - birthday.month = now().month
    order:
      - file.name
      - birthday
      - formula.Age
    sort:
      - property: birthday.day
        direction: ASC
  - type: table
    name: By Organization
    filters:
      and:
        - list(org).contains(this)
    order:
      - file.name
      - role
      - birthday
    sort:
      - property: file.name
        direction: ASC
