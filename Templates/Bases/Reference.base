filters:
  and:
    - categories.contains(link("Reference"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  note.type:
    displayName: Type
  note.institution:
    displayName: Institution
  note.expires:
    displayName: Expires
views:
  - type: table
    name: All
    order:
      - file.name
      - type
      - institution
      - expires
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By Type
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - institution
      - expires
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Expiring Soon
    filters:
      and:
        - expires < (now() + 90 days)
        - expires > now()
    order:
      - file.name
      - type
      - expires
    sort:
      - property: expires
        direction: ASC
