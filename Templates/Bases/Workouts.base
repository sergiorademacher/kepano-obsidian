filters:
  and:
    - categories.contains(link("Workouts"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Workout
  note.type:
    displayName: Type
  note.duration:
    displayName: Duration
  note.intensity:
    displayName: Intensity
  note.date:
    displayName: Date
views:
  - type: table
    name: All
    order:
      - file.name
      - type
      - duration
      - intensity
      - date
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Recent
    order:
      - file.name
      - type
      - duration
      - intensity
      - date
    sort:
      - property: date
        direction: DESC
    limit: 20
  - type: table
    name: By Type
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - duration
      - intensity
      - date
    sort:
      - property: date
        direction: DESC
  - type: table
    name: This Week
    filters:
      and:
        - date >= (now() - 7 days)
    order:
      - file.name
      - type
      - duration
      - intensity
      - date
    sort:
      - property: date
        direction: DESC
  - type: table
    name: This Month
    filters:
      and:
        - date >= (now() - 30 days)
    order:
      - file.name
      - type
      - duration
      - date
    sort:
      - property: date
        direction: DESC
